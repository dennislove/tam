{
  "name": "tnvn-automation",
  "version": "1.1.1",
  "description": "Multi-instance Automation Tool for Thanh Nien Viet Nam App on LDPlayer/Android",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "ui": "tsx src/server.ts",
    "dev": "tsx watch src/index.ts",
    "electron:dev": "tsc && electron .",
    "electron:build": "tsc && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.tnvn.autoexam",
    "productName": "TNVN Auto Exam Pro",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "public/**/*",
      "data/**/*",
      "bin/**/*",
      "answers.json",
      "accounts.json",
      "eng.traineddata",
      "vie.traineddata",
      "!.env",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/@electron/**/*"
    ],
    "asarUnpack": [
      "bin/**/*",
      "node_modules/**/*.node"
    ],
    "extraResources": [
      {
        "from": "eng.traineddata",
        "to": "eng.traineddata"
      },
      {
        "from": "vie.traineddata",
        "to": "vie.traineddata"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TNVN Auto Exam Pro",
      "installerLanguages": ["vi-VN"],
      "language": "1066"
    }
  },
  "keywords": [
    "adb",
    "automation",
    "ldplayer",
    "thanh-nien-viet-nam"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@devicefarmer/adbkit": "^3.3.9",
    "@supabase/supabase-js": "^2.118.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.5",
    "@types/pngjs": "^6.0.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
